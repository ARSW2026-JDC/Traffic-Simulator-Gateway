# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Backend API (NestJS)
BACKEND_URL=http://localhost:4000
# Simulation Server
SIMULATION_URL=http://localhost:3001
# Chat Server
CHAT_URL=http://localhost:3030
# History Server
HISTORY_URL=http://localhost:3060
# Gateway Configuration
ALLOWED_ORIGIN=http://localhost:5173
PORT=3000
# Grafana Cloud
# GRAFANA_CLOUD_URL=https://prometheus-*************.grafana.net/api/prom/push
# GRAFANA_CLOUD_USER=your-username
# GRAFANA_CLOUD_API_KEY=your-api-key
# GRAFANA_CLOUD_PUSH_INTERVAL=15000
